{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.token.email === 'tu7786110@gmail.com' || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        ".write": "auth != null && (auth.token.email === 'tu7786110@gmail.com' || root.child('users').child(auth.uid).child('role').val() === 'admin')"
      }
    },
    "accessRequests": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.token.email === 'tu7786110@gmail.com' || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        ".write": "auth != null && (auth.uid === $uid && (!data.exists() || data.child('status').val() === 'pending')) || auth.token.email === 'tu7786110@gmail.com' || root.child('users').child(auth.uid).child('role').val() === 'admin'"
      }
    },
    "settings": {
      ".read": "auth != null",
      ".write": "auth != null && (auth.token.email === 'tu7786110@gmail.com' || root.child('users').child(auth.uid).child('role').val() === 'admin')"
    }
  }
}
